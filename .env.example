# Copy values into .env.local (never commit .env.local)
# npm run db:* uses: node --env-file=.env.local ...
# Optional: ln -sf .env.local .env  (Prisma bare CLI also reads .env)

# --- Local MySQL (recommended for development) ---
# Replace YOUR_PASSWORD with your local root password (URL-encode special chars if any)
DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/rock_chronicles"

# --- Cloud MySQL example (Aiven etc.) — only when you need remote ---
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/rock_chronicles?ssl-mode=REQUIRED&connect_timeout=60"

# When true (and DATABASE_URL is set), content reads from MySQL via Prisma
# (Band, Person, Era, Genre, Guide, Trope, Live). Otherwise uses content/*.json.
# USE_DATABASE=true
