# Copy values into .env.local (never commit .env.local)
# npm run db:* uses: node --env-file=.env.local ...
# Optional: ln -sf .env.local .env  (Prisma bare CLI also reads .env)

# --- Local MySQL (recommended for development) ---
# Replace YOUR_PASSWORD with your local root password (URL-encode special chars if any)
DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/rock_chronicles"

# --- Cloud MySQL example (Aiven etc.) — only when you need remote ---
# Prefer connection_limit=1 on Vercel (serverless + SSG). pool_timeout helps build.
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/rock_chronicles?ssl-mode=REQUIRED&connect_timeout=60&connection_limit=1&pool_timeout=60"

# Content source: repo JSON is default (content/**).
# Set CONTENT_SOURCE=database to read Band/Person/Era/Genre/Guide/etc from MySQL
# (requires USE_DATABASE=true and DATABASE_URL). Without CONTENT_SOURCE=database,
# production also serves git JSON — so Vercel stays in sync with commits.
# USE_DATABASE=true
# CONTENT_SOURCE=database
# CONTENT_SOURCE=json
# NEXT_PUBLIC_AUDIO_CDN="https://xxx.public.blob.vercel-storage.com/audio"

# Vercel Blob upload token (scripts/upload-audio-blob.mjs only; never expose to client)
# BLOB_READ_WRITE_TOKEN=
